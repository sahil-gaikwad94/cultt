{
  "expo": {
    "name": "cultured",
    "slug": "cultured",
    "scheme": "cultured",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.cultured.mobile"
    },
    "android": {
      "package": "app.cultured.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111018"
      }
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 164,
          "resizeMode": "contain",
          "backgroundColor": "#111018"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos you feel comfortable sharing on your cultured Fingerprint.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
